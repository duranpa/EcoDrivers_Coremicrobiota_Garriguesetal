 permutation_test_by_group <- function(data,
                                       group_col = "State",
                                       property_col = "Betweenness",
                                       n_perm = 10000,
                                       alternative = "two.sided",
                                       seed = 123) {
   set.seed(seed)
   
   # Coerce to vector
   obs_values <- as.vector(unlist(data[[property_col]]))
   groups <- as.vector(unlist(data[[group_col]]))
   
   # Remove NAs
   valid_idx <- complete.cases(obs_values, groups)
   obs_values <- obs_values[valid_idx]
   groups <- groups[valid_idx]
   
   # Ensure matching lengths now
   stopifnot(length(obs_values) == length(groups))
   
   # Observed means
   group_means <- tapply(obs_values, groups, mean)
   group_sizes <- table(groups)
   group_levels <- names(group_means)
   
   # Null distributions via permutation
   perm_means <- replicate(n_perm, {
     permuted <- sample(obs_values)
     tapply(permuted, groups, mean)
   })
   
   # p-values
   pvals <- sapply(seq_along(group_means), function(i) {
     obs <- group_means[i]
     perm <- perm_means[i, ]
     
     if (alternative == "greater") {
       mean(perm >= obs)
     } else if (alternative == "less") {
       mean(perm <= obs)
     } else {
       mean(abs(perm - mean(perm)) >= abs(obs - mean(perm)))
     }
   })
   
