# List and sort edge and node files by bootstrap ID
edge_files <- list.files(pattern = "^edge_full_(\\d{1,2})\\.txt$")
node_files <- list.files(pattern = "^node_full_(\\d{1,2})\\.txt$")

extract_bootstrap_id <- function(x) {
  as.numeric(sub(".*node_full_(\\d+)\\.txt$", "\\1", x))
}
extract_bootstrap_id_edge <- function(x) {
  as.numeric(sub(".*edge_full_(\\d+)\\.txt$", "\\1", x))
}
sorted_edge_files <- edge_files[order(sapply(edge_files, extract_bootstrap_id_edge))]
sorted_node_files <- node_files[order(sapply(node_files, extract_bootstrap_id))]

# Build igraph objects for each bootstrap
graph_list <- list()

for (i in seq_along(sorted_edge_files)) {
  edge_file <- sorted_edge_files[i]
  node_file <- sorted_node_files[i]
  
  edges <- read.table(edge_file, header = TRUE, sep = "\t")
  nodes <- read.table(node_file, header = TRUE, sep = "\t")
  
  nodes$Order <- trimws(nodes$Order)
  nodes$color <- group_colors[nodes$Order]
  nodes$color[is.na(nodes$color)] <- "grey"
  
  g <- graph_from_data_frame(d = edges, vertices = nodes, directed = FALSE)
  V(g)$color <- V(g)$color
  
  bootstrap_id <- extract_bootstrap_id_edge(edge_file)
  graph_list[[paste0("B", bootstrap_id)]] <- g
}

