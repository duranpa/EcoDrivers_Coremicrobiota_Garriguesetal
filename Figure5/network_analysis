# Calculate centrality metrics for each node in all bootstraps
centrality_results <- list()

for (name in names(graph_list)) {
  g <- graph_list[[name]]
  
  degree_centrality <- degree(g)
  closeness_centrality <- closeness(g, normalized = TRUE)
  betweenness_centrality <- betweenness(g, normalized = TRUE)
  
  df <- data.frame(
    Bootstrap = name,
    Node = names(degree_centrality),
    Degree = degree_centrality,
    Closeness = closeness_centrality,
    Betweenness = betweenness_centrality
  )
  
  centrality_results[[name]] <- df
}

# Combine centrality results across all bootstraps
